# OpenAI Configuration (for auditing OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4

# Google Gemini (for auditing Google models)
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude (for auditing Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model being audited (optional, can specify in command line)
TARGET_MODEL=gpt-3.5-turbo

# CrewAI Configuration
CREWAI_VERBOSE=True

# Audit Configuration
AUDIT_SCOPE=comprehensive
SAVE_RESULTS=true
OUTPUT_DIRECTORY=./audit_results
