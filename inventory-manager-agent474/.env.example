# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4

# Optional: Other LLM Providers
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/inventory_db

# ERP/Warehouse Management System Integration (optional)
ERP_API_KEY=your_erp_api_key
WMS_API_KEY=your_wms_api_key
WMS_ENDPOINT=https://wms.example.com/api

# Supplier Integration (optional)
SUPPLIER_API_KEY=your_supplier_api_key

# Alert Configuration
LOW_STOCK_THRESHOLD=100
OVERSTOCK_THRESHOLD=1000
ALERT_EMAIL=inventory@company.com
