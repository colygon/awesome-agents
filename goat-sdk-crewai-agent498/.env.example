# External project reference
# https://github.com/goat-sdk/goat/tree/main/python/examples/by-framework/crewai

# OpenAI API Key (Required by CrewAI)
OPENAI_API_KEY=your_openai_api_key_here

# Solana Wallet Private Key (base58 format)
SOLANA_WALLET_SEED=your_solana_private_key_base58_here

# Solana RPC Endpoint
SOLANA_RPC_ENDPOINT=https://api.mainnet-beta.solana.com
