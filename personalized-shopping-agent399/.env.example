# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4

# Google Gemini (Alternative)
GOOGLE_API_KEY=your_google_api_key_here

# Optional: E-commerce Platform APIs
# Amazon Product Advertising API
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_ASSOCIATE_TAG=your_associate_tag

# Shopify API (for merchant integration)
SHOPIFY_API_KEY=your_shopify_key
SHOPIFY_SHOP_URL=your_shop_url

# Price Tracking APIs
CAMELCAMELCAMEL_API_KEY=your_camel_key
HONEY_API_KEY=your_honey_key

# Coupon APIs
RAKUTEN_API_KEY=your_rakuten_key

# CrewAI Configuration
CREWAI_VERBOSE=True

# Shopping Assistant Configuration
DEFAULT_CURRENCY=USD
DEFAULT_COUNTRY=US
MAX_RECOMMENDATIONS=15
