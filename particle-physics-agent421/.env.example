# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Model Configuration
OPENAI_MODEL_NAME=gpt-4

# Optional: Particle Physics Data Sources
CERN_API_KEY=your_cern_api_key
