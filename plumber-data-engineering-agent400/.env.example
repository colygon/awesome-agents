# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4

# Google Gemini (Alternative)
GOOGLE_API_KEY=your_google_api_key_here

# Source Database Connections (Examples)
SOURCE_DB_HOST=localhost
SOURCE_DB_PORT=5432
SOURCE_DB_NAME=source_database
SOURCE_DB_USER=db_user
SOURCE_DB_PASSWORD=db_password

# Target Data Warehouse
TARGET_DW_HOST=warehouse.example.com
TARGET_DW_PORT=5439
TARGET_DW_NAME=analytics
TARGET_DW_USER=etl_user
TARGET_DW_PASSWORD=etl_password

# Cloud Storage (for staging)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=data-pipeline-staging

# Orchestration
AIRFLOW_HOME=/path/to/airflow
AIRFLOW_DAGS_FOLDER=/path/to/dags

# Monitoring
DATADOG_API_KEY=your_datadog_key
SLACK_WEBHOOK_URL=your_slack_webhook

# CrewAI Configuration
CREWAI_VERBOSE=True

# Pipeline Configuration
PIPELINE_ENVIRONMENT=development
LOG_LEVEL=INFO
