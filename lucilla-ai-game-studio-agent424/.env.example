# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Model Configuration
OPENAI_MODEL_NAME=gpt-4

# Optional: Game Engine APIs
UNITY_API_KEY=your_unity_key
